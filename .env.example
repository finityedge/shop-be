# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Django core ---------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

DEBUG=False

# Comma-separated. Must include the production domain and the compose service
# name (the shared Caddy proxies to `web`, so that Host header can appear).
ALLOWED_HOSTS=shop.example.com,web,localhost,127.0.0.1

# Comma-separated, scheme REQUIRED. Django rejects CSRF-protected POSTs from
# any origin not listed here once it is behind a proxy.
CSRF_TRUSTED_ORIGINS=https://shop.example.com

# Set to False only if you terminate TLS somewhere that does not set
# X-Forwarded-Proto. With the shared Caddy, leave it True.
SECURE_SSL_REDIRECT=True

TZ=Africa/Dar_es_Salaam

# --- Local Postgres (replaces the Azure managed instance) ----------------
# These three are consumed by BOTH the db container (to initialise the cluster)
# and DATABASE_URL below. Keep the values in sync across all four lines.
DB_NAME=shopdb
DB_USER=shopuser
DB_PASSWORD=CHANGE_ME_strong_password

# `db` is the compose service name and resolves on the internal network.
DB_HOST=db
DB_PORT=5432

# Takes precedence over the DB_* vars above in settings.py.
DATABASE_URL=postgres://shopuser:CHANGE_ME_strong_password@db:5432/shopdb

# Seconds to hold persistent db connections. 0 disables pooling.
DB_CONN_MAX_AGE=60

# --- Cloudinary (media stays on Cloudinary; unchanged by this move) -------
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Twilio / WhatsApp ---------------------------------------------------
# Currently only read in settings.py; the sending helper is not wired to a view.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM_NUMBER=

# --- Misc ----------------------------------------------------------------
# Base URL shown in the Swagger UI's "try it out" requests.
SWAGGER_BASE_URL=https://shop.example.com/api/

# Used for links generated back to the frontend.
FRONTEND_URL=https://finityshop.vercel.app

# Seconds the entrypoint waits for Postgres before giving up.
DB_WAIT_TIMEOUT=60
